# ============================================================
# diagnosis-agent local development environment
# 从 harness-fault-diagnosis_1 迁移而来：
# - 旧 DATABASE_URL  -> 新 APP_DATABASE_URL
# - 旧 DB_*          -> 新 DIAG_DB_*
# - 旧 DEEPSEEK_*    -> 新 OPENAI_*，DeepSeek 是 OpenAI-compatible API
# ============================================================


# ============================================================
# App / Local Persistence
# 当前本地需要保存的内容全部先落 SQLite，方便开发测试：
# thread / turn / run / case / trace / tool_call / skill_call /
# RAG document metadata 都保存在这个库。
# 后续切 PostgreSQL 时只需要把 APP_DATABASE_URL 换成 PostgreSQL DSN。
# ============================================================
APP_NAME=diagnosis-agent
APP_TIMEZONE=Asia/Shanghai
APP_DATABASE_URL=sqlite:///./diagnosis_agent.db
APP_DB_ECHO=false

# Backward-compatible alias from old project. 通常不需要设置。
# DATABASE_URL=sqlite:///./harness_fault_diagnosis.db

# Future app PostgreSQL example, not used for current local tests:
# APP_DATABASE_URL=postgresql+psycopg://diagnosis_app:change_me@127.0.0.1:5432/diagnosis_agent


# ============================================================
# Remote Archive Database / Readonly Diagnosis Data Source
# 这是被诊断的历史 PV/archive 数据源，不是本项目本地状态库。
# 建议始终使用只读账号。
#
# 旧项目 .env 中的真实环境形状：
# DB_HOST=192.168.113.42
# DB_PORT=5432
# DB_NAME=hdas
# DB_USER=ro
# DB_PASSWORD=<fill in local .env only>
# ============================================================
DIAG_DB_DRIVER=postgresql+psycopg
DIAG_DB_HOST=127.0.0.1
DIAG_DB_PORT=55432
DIAG_DB_NAME=archive_db
DIAG_DB_USER=readonly_user
DIAG_DB_PASSWORD=change_me

# Optional direct DSN override. If set, it wins over DIAG_DB_HOST/PORT/...
# DIAG_DATABASE_URL=postgresql+psycopg://readonly_user:change_me@127.0.0.1:55432/archive_db

# Backward-compatible aliases from old project. 通常不需要和 DIAG_* 同时设置。
# ARCHIVE_DATABASE_URL=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=hdas
# DB_USER=ro
# DB_PASSWORD=change_me


# ============================================================
# Archive Data Backend
# sql: 继续使用 PostgreSQL 直连。
# http: 使用 HLS TS HTTP 接口获取 PV 历史数据，不直接访问 archive DB。
# 当前 HTTP 实现使用 /hlsTS/history/nameMap/{pv}@/avg/{start}/{end}。
# 为保证诊断证据是 raw 点，超过 2h58m 的时间范围会自动切片后拼接。
# ============================================================
ARCHIVE_DATA_BACKEND=sql

ARCHIVE_HTTP_BASE_URL=http://202.38.77.8
ARCHIVE_HTTP_AUTH_TOKEN=
ARCHIVE_HTTP_JSESSIONID=
ARCHIVE_HTTP_USERNAME=
ARCHIVE_HTTP_PASSWORD=
ARCHIVE_HTTP_LOGIN_URL=https://nsrloa.ustc.edu.cn/cas/login?service=http://202.38.77.8/hlsTS/casCallback
ARCHIVE_HTTP_TIMEOUT_SECONDS=20
ARCHIVE_HTTP_RETRY_TIMES=2
ARCHIVE_HTTP_CHUNK_SECONDS=10680
ARCHIVE_HTTP_MAX_POINTS=50000
ARCHIVE_HTTP_MAX_PATTERN_PVS=500
ARCHIVE_HTTP_LOOKAROUND_SECONDS=86400
ARCHIVE_HTTP_REQUIRE_RAW_SAMPLES=true
ARCHIVE_HTTP_POWER_PREFIXES=SR_PS_,TL_PS_,LA_PS_
# 只在 HTTP 数据源无法从内置 catalog 找到 channel_id -> PV 映射时填写。
# ARCHIVE_HTTP_CHANNEL_ID_MAP={"617":"RNG:BEAM:CURR"}

# 手动/自动束流诊断当前都接入 HTTP 数据源；其它工具仍可通过 ARCHIVE_DATA_BACKEND 控制。
MANUAL_BEAM_DATA_BACKEND=http
# 自动束流诊断数据源。当前已接入 HTTP；如需回退旧 SQL，可改为 sql。
AUTO_BEAM_DATA_BACKEND=http
# 相邻束流采样点 current / previous <= 0.70 时判为快速掉束。
AUTO_BEAM_DROP_STEP_RATIO_THRESHOLD=0.70
# 连续 3 个严格正常窗口后确认恢复。
AUTO_INCIDENT_RECOVERY_CONFIRM_WINDOWS=3


# ============================================================
# Auto Diagnosis Email Notification
# 自动束流诊断只在生成新的故障报告时发送邮件。
# SMTP_RETRY_TIMES=2 表示首次失败后再重试 2 次，共最多 3 次发送尝试。
# ============================================================
AUTO_EMAIL_ENABLED=false
AUTO_EMAIL_DRY_RUN=true
AUTO_EMAIL_TO=
AUTO_EMAIL_FROM=

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=60
SMTP_RETRY_TIMES=2
SMTP_RETRY_DELAY_SECONDS=2


# ============================================================
# Remote DB Runtime Options
# ============================================================
DIAG_DB_TIMEZONE=Asia/Shanghai
DIAG_DB_CONNECT_TIMEOUT=5
DIAG_DB_STATEMENT_TIMEOUT_MS=10000
DIAG_DB_POOL_SIZE=5
DIAG_DB_MAX_OVERFLOW=10
DIAG_DB_POOL_RECYCLE=1800

# Safety limits for readonly queries / PV fetches.
DIAG_DB_MAX_ROWS=1000
DIAG_DB_MAX_QUERY_SECONDS=3600
DIAG_DB_MAX_QUERY_POINTS=50000

# Old aliases:
# ARCHIVE_SESSION_TIMEZONE=Asia/Shanghai
# ARCHIVE_CONNECT_TIMEOUT_SECONDS=5
# DB_TIMEZONE=Asia/Shanghai
# DB_CONNECT_TIMEOUT=5
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_MAX_ROWS=20
# DEFAULT_SQL_MAX_ROWS=20


# ============================================================
# Archive Table Mapping
# New project format accepts fully-qualified table names.
# Old project used schema + table separately; both forms are supported.
# ============================================================
ARCHIVE_SAMPLE_TABLE=public.sample
ARCHIVE_CHANNEL_TABLE=public.channel
ARCHIVE_SAMPLE_CHANNEL_ID_COL=channel_id
ARCHIVE_SAMPLE_TIME_COL=smpl_time
ARCHIVE_SAMPLE_NANOSECS_COL=nanosecs
ARCHIVE_SAMPLE_FLOAT_COL=float_val

ARCHIVE_SAMPLE_RAW_TABLE=public.sample_raw
ARCHIVE_SAMPLE_RAW_CHANNEL_ID_COL=channel_id
ARCHIVE_SAMPLE_RAW_TIME_COL=smpl_time
ARCHIVE_SAMPLE_RAW_NANOSECS_COL=nanosecs
ARCHIVE_SAMPLE_RAW_NUM_VAL_COL=num_val
ARCHIVE_SAMPLE_RAW_SEVERITY_ID_COL=severity_id
ARCHIVE_SAMPLE_RAW_STATUS_ID_COL=status_id

ARCHIVE_CHANNEL_ID_COL=channel_id
ARCHIVE_CHANNEL_NAME_COL=name

# Old aliases:
# ARCHIVE_SAMPLE_SCHEMA=public
# ARCHIVE_SAMPLE_TABLE=sample
# ARCHIVE_CHANNEL_SCHEMA=public
# ARCHIVE_CHANNEL_TABLE=channel
# ARCHIVE_SAMPLE_CHANNEL_ID_COLUMN=channel_id
# ARCHIVE_CHANNEL_ID_COLUMN=channel_id
# ARCHIVE_CHANNEL_NAME_COLUMN=name
# ARCHIVE_TIME_COLUMN=smpl_time
# ARCHIVE_NANOSECS_COLUMN=nanosecs
# ARCHIVE_VALUE_COLUMN=float_val
# ARCHIVE_RAW_VALUE_COLUMN=num_val


# ============================================================
# Diagnosis Defaults
# Defaults copied from harness-fault-diagnosis_1 and extended for V3.
# ============================================================
DEFAULT_BEAM_CHANNEL=RNG:BEAM:CURR
DEFAULT_POWER_PATTERN=%SR_PS_QM%:current:ai

BEAM_NORMAL_LOW=480
BEAM_NORMAL_HIGH=520
BEAM_ABSOLUTE_DROP_THRESHOLD=100
BEAM_RELATIVE_DROP_THRESHOLD=0.4

POWER_WINDOW_SECONDS=10
POWER_RELATIVE_DROP_THRESHOLD=0.2

DECAY_LOOKBACK_MINUTES=30
DECAY_LOOKAHEAD_MINUTES=10
DECAY_RECOVERY_LOOKAHEAD_MINUTES=30
DECAY_ALARM_PRE_WINDOW_MINUTES=10
DECAY_ALARM_POST_WINDOW_SECONDS=60
DECAY_EXACT_MATCH_WINDOW_SECONDS=1
DECAY_DROP_RATIO_THRESHOLD=0.03
DECAY_ABNORMAL_POINT_RATIO_THRESHOLD=0.6
DECAY_ABNORMAL_DURATION_SECONDS=10
DECAY_NEAR_ZERO_RATIO=0.15
DECAY_ABSOLUTE_LOW_THRESHOLD=100

PSS_PV_PREFIX=STCF-BTP:PSS:
# 当前 PSS PV 尚未写入远程归档库，默认使用与 channel/sample_raw 字段一致的 fake archive 数据。
# 后续确认 PV 已归档后可设为 true。
PSS_USE_REMOTE_DB=false
PSS_EVENT_LOOKBACK_SECONDS=5
PSS_EVENT_LOOKAHEAD_SECONDS=2

# Old alias:
# DEFAULT_POWER_WINDOW_SECONDS=10


# ============================================================
# LLM Config
# Current code uses OpenAI-compatible chat completions.
# DeepSeek can be used directly with:
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
# ============================================================
OPENAI_API_KEY=change_me
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.2

# Old aliases supported:
# LLM_PROVIDER=deepseek
# LLM_TIMEOUT_SECONDS=60
# LLM_TEMPERATURE=0.2
# DEEPSEEK_API_KEY=change_me
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
#
# USTC old endpoint is not OpenAI-compatible in this code path unless it
# exposes /v1/chat/completions; prefer setting OPENAI_* to a compatible gateway.
# USTC_LLM_API_KEY=change_me
# USTC_LLM_ENDPOINT=http://scc.ustc.edu.cn/portal/api/ask
# USTC_LLM_MODEL=deepseek-v4


# ============================================================
# RAG / Qdrant Vector Database
# Local default uses embedded Qdrant path so no container is required.
# If using docker-compose.local.yml, comment QDRANT_PATH and set QDRANT_URL.
# ============================================================
AGENT_ENABLE_RAG=false
AGENT_RAG_LIMIT=5
AGENT_RAG_INCLUDE_SYSTEM_DESIGN=false

QDRANT_COLLECTION=diagnosis_rag
QDRANT_VECTOR_SIZE=1024
QDRANT_PATH=.qdrant
# QDRANT_URL=http://127.0.0.1:7333
# QDRANT_API_KEY=

RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024

RAG_SPARSE_EMBEDDING_PROVIDER=hashing
RAG_SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RAG_SPARSE_EMBEDDING_DIMENSION=1048576


# ============================================================
# RAG Original Document Storage / MinIO
# 本地普通诊断和 SQLite trace 不依赖 MinIO。
# 只有保存 RAG 原始文件时需要 MinIO；docker-compose.local.yml 使用 9100/9101。
# ============================================================
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=diagnosis-rag
MINIO_SECURE=false
# MINIO_REGION=us-east-1
MINIO_RAG_RAW_PREFIX=rag/raw
