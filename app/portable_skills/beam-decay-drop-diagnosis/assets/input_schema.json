    "start": {
      "type": "string"
    },
    "end": {
      "type": "string"
    },
    "beam_channel": {
      "type": "string",
      "default": "RNG:BEAM:CURR"
    },
    "beam_samples": {
      "type": "array"
    },
    "mode_samples": {
      "type": "array"
    },
    "alarm_samples": {
      "type": "array"
    },
    "config": {
      "type": "object"
    }
  }
}
